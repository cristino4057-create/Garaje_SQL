    {
        "id": "b820000000000011",
        "type": "function",
        "z": "6d5a2a4e97a84001",
        "name": "Confirmar valor leído del PLC",
        "func": "const pending = flow.get(\"garaje_pending_force\");\nif (!pending || !Number.isInteger(pending.value)) return [null, null];\nif (Date.now() - pending.timestamp > 10000) {\n    flow.set(\"garaje_pending_force\", null);\n    node.warn(\"Forzado cancelado: PV_Forzado no se pudo confirmar desde DB2\");\n    return [null, null];\n}\n\nconst readback = Number(msg.payload);\nif (readback !== pending.value) return [null, null];\n\nif (pending.stage === \"pv\" && Date.now() - pending.timestamp >= 300) {\n    pending.stage = \"ld\";\n    pending.ldAt = Date.now();\n    flow.set(\"garaje_pending_force\", pending);\n    msg.topic = \"Forzar_valor\";\n    msg.payload = true;\n    return [msg, null];\n}\n\nif (pending.stage === \"ld\" && Date.now() - pending.ldAt >= 1000) {\n    flow.set(\"garaje_ocupadas\", pending.value);\n    flow.set(\"garaje_pending_force\", null);\n    delete msg._session;\n    msg.topic = \"Ocupadas\";\n    msg.payload = JSON.stringify({ ocupadas: pending.value, forzado_confirmado: true });\n    return [null, msg];\n}\n\nreturn [null, null];",
        "outputs": 2,
        "timeout": 0,
        "noerr": 0,
        "initialize": "",
        "finalize": "",
