    {
        "id": "b82000000000000b",
        "type": "function",
        "z": "6d5a2a4e97a84001",
        "name": "Publicar estados reales del semáforo",
        "func": "const nombre = String(msg.topic || \"\").toLowerCase();\nconst clave = { verde: \"verde\", ambar: \"ambar\", rojo: \"rojo\" }[nombre];\nif (!clave) return null;\nconst valor = msg.payload === true || msg.payload === 1 || msg.payload === \"1\" || msg.payload === \"true\";\nflow.set(\"garaje_luz_\" + clave, valor);\nconst luces = [\"verde\", \"ambar\", \"rojo\"];\nif (!luces.every(color => typeof flow.get(\"garaje_luz_\" + color) === \"boolean\")) return null;\nconst ocupadas = flow.get(\"garaje_ocupadas\");\nconst salida = { ocupadas: Number.isInteger(ocupadas) ? ocupadas : 0 };\nfor (const color of luces) salida[color] = flow.get(\"garaje_luz_\" + color);\ndelete msg._session;\nmsg.payload = JSON.stringify(salida);\nreturn msg;",
