        "id": "6d5a2a4e97a84008",
        "type": "function",
        "z": "6d5a2a4e97a84001",
        "name": "Preparar lectura para monitor",
        "func": "let valor = msg.payload;\n\nif (valor && typeof valor === \"object\") {\n    const clave = Object.keys(valor).find(nombre => nombre.toLowerCase() === \"ocupadas\");\n    if (!clave) {\n        return null;\n    }\n    valor = valor[clave];\n}\n\nif (typeof valor === \"string\" && valor.trim() !== \"\") {\n    valor = Number(valor);\n}\n\nif (!Number.isInteger(valor) || valor < 0 || valor > 100) {\n    node.warn(\"Lectura ignorada: la ocupación debe ser un entero entre 0 y 100\");\n    return null;\n}\n\nmsg.payload = JSON.stringify({ ocupadas: valor });\nreturn msg;",
