    {
        "id": "6d5a2a4e97a84004",
        "type": "function",
        "z": "6d5a2a4e97a84001",
        "name": "Validar y preparar orden PLC",
        "func": "let orden = msg.payload;\nif (typeof orden === \"string\") {\n    try { orden = JSON.parse(orden); } catch (error) { return null; }\n}\nif (!orden || typeof orden !== \"object\" || Array.isArray(orden)) return null;\n\nif (orden.leer === true) {\n    const ultimoValor = flow.get(\"garaje_ocupadas\");\n    msg.payload = Number.isInteger(ultimoValor) ? ultimoValor : 0;\n    return [null, msg, null, null];\n}\n\nif (orden.reset === true) {\n    msg.topic = \"Reiniciar\";\n    msg.payload = true;\n    return [null, null, null, msg];\n}\n\nif (!Object.prototype.hasOwnProperty.call(orden, \"forzar\")) return null;\nconst valor = Number(orden.forzar);\nif (!Number.isInteger(valor) || valor < 0 || valor > 100) return null;\nif (flow.get(\"garaje_pending_force\")) return null;\nconst timestamp = Date.now();\nconst session = msg._session;\nflow.set(\"garaje_pending_force\", { value: valor, timestamp, stage: \"pv\", session });\nsetTimeout(() => {\n    const pending = flow.get(\"garaje_pending_force\");\n    if (!pending || pending.timestamp !== timestamp) return;\n    flow.set(\"garaje_pending_force\", null);\n    node.send([null, null, { _session: session, payload: JSON.stringify({ error: \"PLC_READBACK_TIMEOUT\" }) }, null]);\n}, 10000);\nmsg.topic = \"PV_Forzado\";\nmsg.payload = valor;\nreturn [msg, null, null, null];",
