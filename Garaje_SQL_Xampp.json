    {
        "id": "a710000000000008",
        "type": "function",
        "z": "6d5a2a4e97a84001",
        "name": "Contar flancos y reset",
        "func": "const signal = msg.topic;\nif (![\"Entra_Vehiculo\", \"Sale_Vehiculo\", \"Reiniciar\"].includes(signal)) return null;\n\nlet raw = msg.payload;\nif (raw && typeof raw === \"object\") {\n    if (Object.prototype.hasOwnProperty.call(raw, signal)) raw = raw[signal];\n    else if (Object.keys(raw).length === 1) raw = Object.values(raw)[0];\n}\nconst active = raw === true || raw === 1 || raw === \"1\" || raw === \"true\";\nconst stateKey = `garaje_sensor_${signal}`;\nconst previous = flow.get(stateKey);\nflow.set(stateKey, active);\n\nlet count = flow.get(\"garaje_ocupadas\");\nif (!Number.isInteger(count)) count = 0;\nconst oldCount = count;\n\nif (previous !== undefined) {\n    if (signal === \"Reiniciar\" && !previous && active) count = 0;\n    if (signal === \"Entra_Vehiculo\" && previous && !active) count += 1;\n    if (signal === \"Sale_Vehiculo\" && previous && !active) count -= 1;\n}\n\ncount = Math.max(0, Math.min(100, count));\nif (count === oldCount) return null;\nflow.set(\"garaje_ocupadas\", count);\nmsg.topic = \"Ocupadas\";\nmsg.payload = count;\nreturn msg;",
        "outputs": 1,
        "timeout": 0,
        "noerr": 0,
