        "z": "6d5a2a4e97a84001",
        "name": "Publicar ocupación y salidas PLC",
        "func": "delete msg._session;\nlet valor = Number(msg.payload);\nif (!Number.isInteger(valor)) {\n    valor = flow.get(\"garaje_ocupadas\");\n}\nif (!Number.isInteger(valor)) valor = 0;\nconst salida = { ocupadas: valor };\nconst luces = [\"verde\", \"ambar\", \"rojo\"];\nconst completas = luces.every(nombre => typeof flow.get(\"garaje_luz_\" + nombre) === \"boolean\");\nif (completas) {\n    for (const nombre of luces) salida[nombre] = flow.get(\"garaje_luz_\" + nombre);\n}\nmsg.payload = JSON.stringify(salida);\nreturn msg;",
